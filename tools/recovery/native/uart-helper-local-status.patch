+static void publish_state(const struct session *session, const struct operation *operation,
+                          enum d9w_status_state state)
+{
+    if (session->status_dir < 0)
+        return;
+    const struct d9w_operation_status status = {
+        .operation = operation->status_operation, .state = state,
+    };
+    (void)d9w_status_publish_at(session->status_dir, &status);
+}
+
+static void heartbeat(const struct session *session, const struct operation_output *output,
+                      int64_t *next)
+{
+    if (session->status_dir < 0)
+        return;
+    const int64_t now = ms_now();
+    if (now >= 0 && now >= *next) {
+        (void)d9w_status_publish_at(session->status_dir, &output->monitor.status);
+        *next = now + 1000;
+    }
+}
